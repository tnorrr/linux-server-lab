# Copy this file to .env and fill in your own values.
# Never commit the actual .env file — it's excluded via .gitignore.

# Your timezone, for accurate log timestamps (e.g. America/New_York, America/Los_Angeles)
TZ=America/New_York

# Absolute path on the host to your media library (mounted into Jellyfin)
MEDIA_PATH=/home/youruser/media

# Pi-hole admin password. Leave blank to have Pi-hole auto-generate one on
# first start (grab it from `docker logs pihole`) rather than setting your
# own value here in plaintext.
PIHOLE_WEBPASSWORD=

# Host/IP allowed to access the Homepage dashboard (comma-separated if more than one)
HOMEPAGE_ALLOWED_HOSTS=your-server-ip:3000
