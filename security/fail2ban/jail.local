# jail.local — copied from jail.conf so package updates won't silently
# overwrite local customization. This is the SSH jail section only;
# the rest of the file is left at jail.conf's defaults.

[sshd]
enabled = true
port = 2222
filter = sshd
logpath = /var/log/auth.log
maxretry = 5
bantime = 3600
findtime = 600
